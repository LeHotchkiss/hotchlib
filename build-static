#!/bin/sh

rm ./.obj/* > /dev/null &2>1
mkdir -p ./.obj > /dev/null &2>1

echo "Compiling as a static library..."

cd src
for CFILE in $(find . -maxdepth 1 -name "*.cpp"); do
	echo "	File: $CFILE"
	g++ -O2 -fno-exceptions -std=c++17 -c "$CFILE" -o "../.obj/$CFILE.o" -I"../include" -I"../include/hlib"

	if [ $? -ne 0 ]; then
        echo "Compilation failed"
        exit 1
    fi
done

echo "Linking..."
cd ..

ar rcs libhotch.a $(find ./.obj -maxdepth 1 -name "*.o")

if [ $? -ne 0 ]; then
	echo "Linking failed"
    exit 1
fi
