version 100

base_target {
    depends []
    depends_ex []

    class "exe"

    includes [ ]
    source [ ]
    lib [ ]

    link [ ]
    link_shared [ ]

    compiler "g++"

    cc_args ["-std=c++17" "-fno-exceptions"]
    ld_args [ ]

    out "test"
}

targets {
    main {
        concat "base_target"

        class "static"

        includes [
            "." "src" "include" "include/hlib"
        ]

        source [
            "src/*.cpp"
        ]

        out "libhotch.a"
    }

    main_pic {
        concat "targets.main"

        cc_args ["-fPIC"]
        out "libhotch.pic.a"
    }

    shared {
        concat "targets.main"
        
        class "shared"
        out "libhotch.so"
    }
}
